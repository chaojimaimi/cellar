    "calibration.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full cycle takes about 6–10 hours — start it overnight while plugged in. During discharge the adapter is disabled and USB peripherals lose power; the whole machine runs on battery, so power use is noticeable. You can cancel anytime; after a restart you must start over."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全程约 6–10 小时，建议睡前插电启动；放电阶段会禁用适配器，USB 外设将断电；放电阶段整机由电池供电、耗电明显；可随时取消，重启后需重新开始。"
          }
        }
      }
    },
