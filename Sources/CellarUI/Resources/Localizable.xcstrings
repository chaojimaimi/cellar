    "fan.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boosts the fan automatically when battery temperature exceeds the threshold"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池温度超过阈值时自动提速风扇降温"
