    "onboarding.enabledNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The daemon is enabled — moving on to the charging limit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "守护进程已启用，即将进入上限设置。"
          }
        }
      }
    },
    "onboarding.genericBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The following names look like battery/charging management tools, though this may be a false positive (e.g. office apps whose names contain the “power” root). If another tool really manages charging, quit it before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下名称疑似电池/充电管理工具，可能为误报（如办公软件名称含 power 词根）。如确有其他工具在管理充电，请先退出后再继续。"
          }
        }
      }
    },
    "onboarding.genericTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Possibly similar tools detected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到疑似同类工具"
          }
        }
      }
    },
    "onboarding.installBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellar's charge limiting runs in a root daemon. After installing, approve the authorization in System Settings; Cellar starts working once approved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellar 的限充由一个 root 守护进程执行。安装后请在系统设置中批准授权，批准后 Cellar 开始工作。"
          }
        }
      }
    },
    "onboarding.limitBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charging stops at the limit and resumes when the level drops to (limit − hysteresis). The minimum is 60% (the 60% floor)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "达到上限停止充电，降至（上限 − 滞回）后恢复。最低 60%（60 地板）。"
          }
        }
      }
    },
    "onboarding.limitTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the Charging Limit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定充电上限"
          }
        }
      }
    },
    "onboarding.migrateNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A manually installed daemon was detected. Run sudo cellar uninstall to clean it up, then come back to continue installing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到手工安装的守护进程。请先运行 sudo cellar uninstall 清理，再回来继续安装。"
