    "onboarding.blockedBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two managers writing the same charging-control keys fight each other, so Cellar refuses to install. Quit and uninstall the tools below, then recheck."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个管理器同时写充电控制键会互相打架，Cellar 拒绝安装。请先退出并卸载以下工具，然后重新检查。"
          }
        }
      }
    },
