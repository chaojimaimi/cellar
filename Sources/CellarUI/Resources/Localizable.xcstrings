    "onboarding.welcomeBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellar installs a root daemon and takes over charge limiting: charging stops at the limit and resumes when the level drops below the limit minus hysteresis (the resume threshold). The limit has a 60% floor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellar 将安装一个 root 守护进程并接管限充：电量达到上限时停止充电，降至上限减滞回（恢复阈值）后恢复。上限最低 60%（60 地板）。"
          }
        }
      }
    },
