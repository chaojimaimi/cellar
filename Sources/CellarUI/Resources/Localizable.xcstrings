        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请升级守护进程以使用风扇降温"
          }
        }
      }
    },
    "fan.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, the daemon raises the fan when the temperature exceeds the threshold. Turning the switch off or quitting the app restores system fan control."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，温度超过阈值时守护进程将提高风扇转速；关闭开关或退出 App 时自动恢复系统控制。"
          }
        }
      }
    },
