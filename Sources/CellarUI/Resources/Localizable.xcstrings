    "settings.autoDischarge.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Discharging consumes battery cycle count\n2. External devices may lose power during discharge (the adapter is disabled)\n3. When the trigger condition is met, a full charge will also be discharged back to the limit\n4. Discharge can be stopped anytime by unplugging, sleep, or the thermal safeguard"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 放电会消耗电池循环计数\n2. 放电期间外接设备可能断电（适配器被禁用）\n3. 满足触发条件时，充满一次完成后的电量也会被自动放回上限\n4. 放电可随时被拔电、睡眠或温度安全机制中止"
          }
        }
      }
    },
